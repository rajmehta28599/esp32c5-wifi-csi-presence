// Windows: merge these into Antigravity's USER settings
// (Ctrl+Shift+P -> "Preferences: Open User Settings (JSON)").
// They are the machine-specific keys that used to sit in the tracked
// .vscode/settings.json files (values copied from those files as they
// were on 2026-10-12). See docs/ide/README.md.
//
// Simplest alternative to pasting: run "ESP-IDF: Select Current ESP-IDF
// Version" once and pick C:\esp\v6.0.2\esp-idf; the extension writes
// idf.currentSetup to user settings itself (idf.saveScope default = Global).
// You still need idf.customExtraVars below: the v2.3.0 extension takes
// IDF_PATH from it, not from the EIM activation script.
{
  "idf.currentSetup": "C:\\esp\\v6.0.2\\esp-idf",
  "idf.customExtraVars": {
    "IDF_PATH": "C:\\esp\\v6.0.2\\esp-idf",
    "IDF_TOOLS_PATH": "C:\\Espressif\\tools",
    "IDF_PYTHON_ENV_PATH": "C:\\Espressif\\tools\\python\\v6.0.2\\venv",
    "OPENOCD_SCRIPTS": "C:\\Espressif\\tools\\openocd-esp32\\v0.12.0-esp32-20260424\\openocd-esp32\\share\\openocd\\scripts",
    "ESP_ROM_ELF_DIR": "C:\\Espressif\\tools\\esp-rom-elfs\\20241011",
    "IDF_CCACHE_ENABLE": "1"
  },
  "idf.customExtraPaths": "C:\\Espressif\\tools\\riscv32-esp-elf\\esp-15.2.0_20251204\\riscv32-esp-elf\\bin;C:\\Espressif\\tools\\riscv32-esp-elf-gdb\\17.1_20260402\\riscv32-esp-elf-gdb\\bin;C:\\Espressif\\tools\\xtensa-esp-elf\\esp-15.2.0_20251204\\xtensa-esp-elf\\bin;C:\\Espressif\\tools\\xtensa-esp-elf-gdb\\17.1_20260402\\xtensa-esp-elf-gdb\\bin;C:\\Espressif\\tools\\esp32ulp-elf\\2.38_20240113\\esp32ulp-elf\\bin;C:\\Espressif\\tools\\cmake\\4.0.3\\bin;C:\\Espressif\\tools\\openocd-esp32\\v0.12.0-esp32-20260424\\openocd-esp32\\bin;C:\\Espressif\\tools\\ninja\\1.12.1;C:\\Espressif\\tools\\idf-exe\\1.0.3;C:\\Espressif\\tools\\ccache\\4.12.1\\ccache-4.12.1-windows-x86_64;C:\\Espressif\\tools\\dfu-util\\0.11\\dfu-util-0.11-win64;C:\\Espressif\\tools\\python\\v6.0.2\\venv\\Scripts",
  "idf.port": "COM13",
  "clangd.path": "C:\\Espressif\\tools\\esp-clang\\esp-20.1.1_20250829\\esp-clang\\bin\\clangd.exe",
  "clangd.arguments": [
    "--background-index",
    "--query-driver=**",
    "--compile-commands-dir=${workspaceFolder}\\build"
  ]
}
