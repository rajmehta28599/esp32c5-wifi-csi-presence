# ---------------------------------------------------------------------------
#  ESP-IDF build output
#  ~230 MB per project, nine of them here. Never commit these.
# ---------------------------------------------------------------------------
build/

# ---------------------------------------------------------------------------
#  Generated config
#  sdkconfig is regenerated by `idf.py menuconfig` / the build, and it holds
#  CONFIG_CSI_WIFI_SSID and CONFIG_CSI_WIFI_PASSWORD -- your real Wi-Fi
#  credentials once you set them. sdkconfig.defaults IS tracked: it is the
#  checked-in seed and carries no credentials.
# ---------------------------------------------------------------------------
sdkconfig
sdkconfig.old

# ---------------------------------------------------------------------------
#  ESP-IDF component manager
# ---------------------------------------------------------------------------
#  managed_components/ is downloaded output - never tracked.
managed_components/

#  dependencies.lock IS tracked, deliberately. It was ignored here until
#  2026-09-07, which was harmless while the repo had no external components -
#  Step 09 added the first one. The lock file is what pins esp_wifi_sensing
#  0.1.1~2 / esp-radar 0.3.4 exactly; without it a later 0.4.x resolves
#  silently and the benchmark stops being a benchmark.
!dependencies.lock

# ---------------------------------------------------------------------------
#  clangd / IDE caches  (the .clangd config files themselves are tracked)
# ---------------------------------------------------------------------------
.cache/
compile_commands.json

# ---------------------------------------------------------------------------
#  Python (tools/)
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]

# ---------------------------------------------------------------------------
#  OS cruft
# ---------------------------------------------------------------------------
Thumbs.db
desktop.ini
.DS_Store

# ---------------------------------------------------------------------------
#  AI coding assistants (Claude Code / Gemini / Antigravity)
#  Local agent config, memory and session state -- machine-specific, and
#  .claude/settings.local.json can hold tokens.
# ---------------------------------------------------------------------------
CLAUDE.md
CLAUDE.local.md
.claude/
.claudeignore
GEMINI.md
GEMINI.local.md
.gemini/
.geminiignore
.antigravity/
.aider*
.mcp.json
