{
  "files.associations": {
    "*.h": "c",
    "*.c": "c",
    "sdkconfig": "properties",
    "sdkconfig.defaults": "properties",
    "Kconfig.projbuild": "kconfig"
  },
  "files.exclude": {
    "**/build": true,
    "**/managed_components": true
  },
  "search.exclude": {
    "**/build": true,
    "**/sdkconfig": true,
    "**/sdkconfig.old": true
  },
  "C_Cpp.intelliSenseEngine": "disabled",
  // -----------------------------------------------------------------
  //  2026-10-12 - NO MACHINE PATHS IN THIS FILE (or any step's).
  //  This repo is opened from Windows (D:\ESP32C5_CSI) AND from Ubuntu
  //  (/mnt/vol1/ESP32C5_CSI) on the same dual-boot disk. Folder settings
  //  beat user settings, so a C:\ path here (idf.currentSetup,
  //  idf.customExtraVars IDF_PATH, clangd.path, --compile-commands-dir)
  //  broke the extension on Linux. Those keys, and idf.port, now live in
  //  each OS's Antigravity USER settings; templates and the reasoning are
  //  in docs/ide/ (README.md there). After pulling this on Windows, paste
  //  docs/ide/windows-user-settings.jsonc into the user settings once.
  // -----------------------------------------------------------------
  "idf.flashBaudRate": "460800",
  "idf.monitorBaudRate": "115200",
  "idf.enableCCache": true,
  "idf.saveBeforeBuild": true,
  "idf.notificationMode": "All",
  "idf.enableSerialPortChipIdRequest": true,
  "idf.openOcdConfigs": [
    "board/esp32c5-builtin.cfg"
  ],
  "idf.flashType": "UART",
  "idf.currentSetup": "/home/rajmehta/.espressif/v6.1/esp-idf"
}
